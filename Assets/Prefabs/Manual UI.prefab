--- !u!114 &4658174419776580174
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1046871847111834441}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. \uC774 \uC2E4\uD5D8\uC758 \uCC38\uAC00\uC790\uB294 \uCD1D 5\uBA85\uC785\uB2C8\uB2E4.\r\n2.
    \uC778\uD130\uD3F0\uC744 \uD1B5\uD55C \uB2E4\uB978 4\uBA85\uC758 \uCC38\uAC00\uC790\uB4E4\uACFC\uC758
    \uB17C\uC758 \uC2DC\uAC04\uC774 \uC8FC\uC5B4\uC9D1\uB2C8\uB2E4. \uC624\uC9C1
    1\uB3001 \uB300\uD654\uB9CC \uAC00\uB2A5\uD55C \uC810\uC744 \uC720\uC758\uD574
    \uC8FC\uC138\uC694.\r\n3. \uBAA8\uB4E0 \uCC38\uAC00\uC790\uB4E4\uC774 \uD55C
    \uBC88\uC529 \uB300\uD654\uB97C \uB098\uB208 \uD6C4, \uD22C\uD45C\uAC00 \uC2DC\uC791\uB429\uB2C8\uB2E4.
    \uD574\uB2F9 \uD22C\uD45C\uB294 \uB2E4\uC218\uACB0\uC758 \uC6D0\uCE59\uC744 \uB530\uB974\uBA70
    \uC790\uAE30 \uC790\uC2E0 \uB610\uD55C \uD22C\uD45C \uAC00\uB2A5\uD569\uB2C8\uB2E4.\r\n4.
    \uC81C\uD55C \uC2DC\uAC04 \uB0B4\uC5D0 \uD22C\uD45C\uD558\uC9C0 \uC54A\uC73C\uBA74
    \uC790\uB3D9\uC73C\uB85C \uC790\uAE30 \uC790\uC2E0\uC5D0\uAC8C \uD22C\uD45C\uD55C
    \uAC83\uC73C\uB85C \uCC98\uB9AC\uB429\uB2C8\uB2E4.\r\n5. \uD22C\uD45C \uACB0\uACFC\uAC00
    \uB3D9\uB960\uC778 \uACBD\uC6B0, \uB3D9\uB960\uC778 \uD6C4\uBCF4\uB4E4\uC744
    \uB300\uC0C1\uC73C\uB85C \uC7AC\uD22C\uD45C\uB97C \uC9C4\uD589\uD569\uB2C8\uB2E4.
    \uC7AC\uD22C\uD45C\uC5D0\uC11C\uB3C4 \uB3D9\uB960\uC774 \uB098\uC624\uBA74, \uC7AC\uD22C\uD45C
    \uD6C4\uBCF4 \uC911 \uD55C \uBA85\uC774 \uB79C\uB364\uD558\uAC8C \uC120\uCD9C\uB429\uB2C8\uB2E4.\r\n6.
    \uC120\uCD9C\uB41C \uC0AC\uB78C\uC740 \uC624\uB978\uC190\uC758 \uC790\uB3D9 \uC8FC\uC0AC
    \uC7A5\uCE58\uB97C \uD1B5\uD574 \uC57D\uBB3C\uC744 \uC8FC\uC785\uBC1B\uC2B5\uB2C8\uB2E4.\r\n7.
    \uD55C \uC0AC\uB78C\uC774 \uC57D\uBB3C\uC744 \uCD1D \uC138 \uBC88 \uC8FC\uC785\uBC1B\uC73C\uBA74
    \uC0AC\uB9DD\uD569\uB2C8\uB2E4.\r\n8. \uC704\uC758 \uACFC\uC815\uC744 \uC77C\uC815
    \uD69F\uC218 \uBC18\uBCF5\uD55C \uD6C4 \uC2E4\uD5D8\uC774 \uC885\uB8CC\uB429\uB2C8\uB2E4.
    \uC815\uD655\uD55C \uD69F\uC218\uB294 \uB9D0\uC500\uB4DC\uB9B4 \uC218 \uC5C6\uC9C0\uB9CC,
    \uC804\uC6D0\uC774 \uC0AC\uB9DD\uD558\uB294 \uC77C\uC740 \uC5C6\uB2E4\uACE0 \uC7A5\uB2F4\uD569\uB2C8\uB2E4."
  m_isRightToLeft: 0
